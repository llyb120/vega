# Send only build inputs; never send host DBs, browser profiles or secrets.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!nitro.config.ts
!tsconfig.json
!server/
!server/**
!shared/
!shared/**
!web/
!web/**
!docker/
!docker/**
!local/
!local/*.go
!local/*.html
!local/*.js
!local/*.syso
!local/go.mod
!local/go.sum
!local/icon.ico
!local/VERSION
!local/extension/
!local/extension/**
!scripts/
!scripts/client-manifest.mjs
web/public/clients/
**/node_modules
**/dist
**/.env
**/.env.*
**/*.db
**/*.db-wal
**/*.db-shm
**/*.log
**/*.key
**/*.pem
**/credentials.*
