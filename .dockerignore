# Send only build inputs; never send host DBs, browser profiles or secrets.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!nitro.config.ts
!tsconfig.json
!server/
!server/**
!shared/
!shared/**
!web/
!web/**
!extensions/
!extensions/nova-chrome/
!extensions/nova-chrome/**
!docker/
!docker/**
!local/
!local/*.go
!local/go.mod
!local/go.sum
!local/icon.ico
web/public/clients/
**/node_modules
**/dist
**/.env
**/.env.*
**/*.db
**/*.db-wal
**/*.db-shm
**/*.log
**/*.key
**/*.pem
**/credentials.*
