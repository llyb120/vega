{
  "name": "vega",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "dev": "nitro dev",
    "dev:web": "vite --config web/vite.config.js",
    "build:web": "vite build --config web/vite.config.js",
    "build": "npm run build:web && nitro build",
    "start": "node .output/server/index.mjs",
    "test": "tsx --test tests/*.test.ts local/extension/vega-chrome/worker.test.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "0.8.3",
    "jsonc-parser": "3.3.1",
    "mysql2": "^3.24.6",
    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "vue": "3.6.0-rc.14",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "6.0.10",
    "nitropack": "2.13.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^7.3.7"
  }
}
