{
  "manifest_version": 3,
  "incognito": "spanning",
  "name": "Vega Chrome",
  "version": "0.2.0",
  "minimum_chrome_version": "125",
  "description": "自动连接 Vega 本机客户端，用稳定 tag 操作 Chrome，快捷复制当前标签页标识。扩展身份与回环端口只属于 Vega，不和 Nova 共用。",
  "key": "",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms", "downloads", "webNavigation"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}],
  "action": {"default_title": "Vega Chrome", "default_popup": "popup.html"}
}
