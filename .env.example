# 环境变量示例，不要把真实凭据提交到仓库
NITRO_HOST=127.0.0.1
NITRO_PORT=8080
VEGA_DB=vega-nitro.db
# 至少16个字符：仅用于首次管理员初始化和容器health，不是网站登录密码
VEGA_TOKEN=
# 公网HTTPS部署的精确origin；启用Secure Cookie，不带路径
# VEGA_PUBLIC_URL=https://vega.example.com
# 可选：32字节Base64或64位hex，在数据库之外保管
VEGA_VAULT_KEY=
# VEGA_POWERSHELL=C:/Program Files/PowerShell/7/pwsh.exe
# VEGA_SKILLS_DIR=D:/skills
# VEGA_SKILL_CACHE=D:/data/vega-skill-cache
# NOVA_CHROME_PORT=47653
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
